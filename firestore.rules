rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Authenticated users can only read and write their own profile and data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // All subcollections under the user (history, measurements, devices)
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Deny all access to any collections outside /users/{userId}
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
